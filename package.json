{
  "name": "crud-api",
  "version": "1.0.0",
  "description": "CRUD API with in-memory database",
  "main": "dist/index.js",
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "nodemon --exec ts-node src/index.ts",
    "start:prod": "cross-env NODE_ENV=production npm run build && node dist/index.js",
    "start:multi": "ts-node src/index.ts --cluster",
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "clean": "node -e \"const fs = require('fs'); try { fs.rmSync('./dist', { recursive: true, force: true }); console.log('Dist folder cleaned'); } catch(e) { console.log(e.message); }\"",
    "rebuild": "npm run clean && npm run build",
    "webpack": "webpack --config webpack.config.js"
  },
  "keywords": [
    "crud",
    "api",
    "nodejs",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.2",
    "@types/uuid": "^9.0.4",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.4",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}